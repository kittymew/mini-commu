# All VITE_ values are public. Never put secret/service_role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local development URL. For deployment: https://kittymew.github.io/mini-commu/
VITE_SITE_URL=http://localhost:5173/mini-commu/

# Optional: defaults to <VITE_SUPABASE_URL>/functions/v1/profile-image.
# dev:local sets the local trusted processor URL automatically.
# VITE_PROFILE_UPLOAD_URL=

# Optional post image endpoint override; defaults to <Supabase URL>/functions/v1/post-image.
# VITE_POST_UPLOAD_URL=
